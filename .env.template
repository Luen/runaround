# Copy to `.env` and fill in real values. Never commit `.env`.

# Postgres — Supabase/Vercel inject these by default.
# POSTGRES_URL is the pooled URL (runtime). POSTGRES_URL_NON_POOLING is the
# direct URL; used as fallback (handy for migrations if pooling misbehaves).
POSTGRES_URL=postgres://runaround:runaround@localhost:5432/runaround
# POSTGRES_URL_NON_POOLING=postgres://runaround:runaround@localhost:5432/runaround

# Public origin (required for auth and form actions)
ORIGIN=http://localhost:5173

# Better Auth — 32+ character secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Strava OAuth app (login + activity sync)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_VERIFY_TOKEN=your_verify_token

# Maps — MapTiler: Outdoors (Wanderstories custom vector style) + Satellite when keyed;
# otherwise OSM raster. PUBLIC_ prefix required for client-side use. Do not hardcode keys.
PUBLIC_MAPTILER_API_KEY=

# Admins (comma-separated). Admin is never granted at onboarding; run
# `pnpm run grant-admin` after the operator has signed in with Strava.
ADMIN_EMAILS=info@runaround.com.au

# Cloudflare Email Sending
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MAIL_FROM=info@runaround.com.au
# Optional key for signed newsletter unsubscribe links; falls back to BETTER_AUTH_SECRET.
# NEWSLETTER_SECRET=

# Admin "Draw on map" course routing (snap-to-path). Optional: without it, drawn
# segments are straight lines. Server-side only (never PUBLIC_).
#   ors         openrouteservice (free key at openrouteservice.org), profile foot-hiking
#   graphhopper GraphHopper (key at graphhopper.com), profile foot (or hike if your plan has it)
#   osrm        self-hosted OSRM foot profile; set ROUTING_BASE_URL, no key
ROUTING_PROVIDER=
ROUTING_API_KEY=
# ROUTING_BASE_URL=
# ROUTING_PROFILE=

# Docker/adapter-node only: allow runner GPX uploads (up to 4 MB) — default limit is 512K.
BODY_SIZE_LIMIT=5M

# Email (magic-link) sign-in. Off unless "true" AND the Cloudflare email vars above
# are set on the web app (links are sent from the web request, not the worker).
MAGIC_LINK_ENABLED=false

# Garmin Connect activity sync (#107). Off unless GARMIN_ENABLED=true and all
# three values are set. Register the Activity API push webhook as
#   <ORIGIN>/api/garmin/webhook?secret=<GARMIN_WEBHOOK_SECRET>
# and the OAuth redirect as <ORIGIN>/api/garmin/callback.
GARMIN_ENABLED=false
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_WEBHOOK_SECRET=
