{
	"name": "runaround",
	"private": true,
	"version": "2.1.1",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up db -d",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"migrate:legacy": "tsx --env-file=.env src/scripts/migrate-legacy.ts",
		"grant-admin": "tsx --env-file=.env src/scripts/grant-admin.ts",
		"worker": "tsx --env-file=.env src/worker/index.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"better-auth": "^1.7.2",
		"drizzle-orm": "^0.45.4",
		"maplibre-gl": "^6.6.0",
		"postgres": "^3.4.9",
		"sharp": "^0.35.5",
		"tsx": "^4.23.12",
		"zod": "^4.6.6"
	},
	"pnpm": {
		"overrides": {
			"brace-expansion": ">=5.0.12",
			"cookie": "0.7.2",
			"devalue": "5.9.4",
			"esbuild": "^0.28.2",
			"postcss-selector-parser": "^7.1.6",
			"source-map-js": "^1.2.2"
		}
	},
	"packageManager": "pnpm@10.33.0"
}
