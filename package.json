{
	"name": "runaround",
	"private": true,
	"version": "2.3.3",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up db -d",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"migrate:legacy": "tsx --env-file=.env src/scripts/migrate-legacy.ts",
		"grant-admin": "tsx --env-file=.env src/scripts/grant-admin.ts",
		"worker": "tsx --env-file=.env src/worker/index.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.12",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"better-auth": "1.7.16",
		"drizzle-orm": "^0.45.4",
		"maplibre-gl": "^6.16.0",
		"postgres": "^3.4.9",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"zod": "^4.6.7"
	},
	"pnpm": {
		"overrides": {
			"brace-expansion": ">=5.0.12",
			"devalue": "5.9.4",
			"esbuild": "^0.28.2",
			"minimatch": ">=11.0.1",
			"postcss-selector-parser": "^7.1.6",
			"source-map-js": "^1.2.2"
		}
	},
	"packageManager": "pnpm@10.33.0"
}
