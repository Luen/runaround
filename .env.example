# Copy to `.env` and fill in real values. Never commit `.env`.
# Same keys as `.env.template`.

# Postgres
DATABASE_URL=postgres://runaround:runaround@localhost:5432/runaround

# Public origin (required for auth and form actions)
ORIGIN=http://localhost:5173

# Better Auth — 32+ character secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Strava OAuth app (login + activity sync)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_VERIFY_TOKEN=your_verify_token

# Legacy scrape tokens (were in strava_config.json / build.js).
# The SvelteKit app stores per-athlete tokens after OAuth; these are optional.
STRAVA_ACCESS_TOKEN=your_access_token
STRAVA_REFRESH_TOKEN=your_refresh_token
STRAVA_USERNAME=your_username
STRAVA_PASSWORD=your_password

# Maps — either a full tile URL, or a Thunderforest key (do not hardcode keys in source)
PUBLIC_MAP_TILES=
PUBLIC_THUNDERFOREST_API_KEY=your_thunderforest_key

# Admins (comma-separated emails collected at onboarding)
ADMIN_EMAILS=info@runaround.com.au

# Cloudflare Email Sending
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MAIL_FROM=info@runaround.com.au
